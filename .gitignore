# Terraform provider binaries and plugins (huge, never commit these)
**/.terraform/
# Terraform state files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*
*.tfplan

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock file IS committed (it pins provider versions)
# .terraform.lock.hcl  <-- do NOT ignore this one

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Lambda build artifacts
*.zip
**/*.zip
lambda/create-schema.zip
terraform/authorizer.zip
terraform/notify_success.zip

# Dynamic per-tenant terraform files (must never be committed)
terraform/tenant_*.tf
!terraform/tenant_*.tf.example

# Local screenshots and adhoc notes
*.png
response.json
terraform/response.json

# ==============================================================================
# TryBase: Static / GitOps Tenant Example
# 
# In automated mode, TryBase generates this file dynamically via AWS CodeBuild
# and saves it to S3 as `tenant_<tenant_id>.tf`.
# 
# If you prefer pure GitOps (declaring tenants manually in Terraform):
# 1. Copy this file: cp tenant_example.tf.example tenant_acme.tf
# 2. Replace all occurrences of "acme" with your tenant slug.
# 3. Choose a unique alb_listener_rule_priority (between 100 and 50000).
# 4. Run `terraform apply -target=module.acme`.
# ==============================================================================

resource "random_password" "key_acme" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "key_acme" {
  name                    = "n8n-hosting/tenant/acme/encryption-key"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "key_acme" {
  secret_id     = aws_secretsmanager_secret.key_acme.id
  secret_string = random_password.key_acme.result
}

module "acme" {
  source = "./modules/tenant"

  tenant_id = "acme"
  subdomain = "acme"
  db_schema = "acme"

  # Networking & Cluster
  vpc_id                         = module.vpc.vpc_id
  private_subnet_ids             = module.vpc.private_subnets
  ecs_cluster_name               = aws_ecs_cluster.main.name
  alb_listener_arn               = aws_lb_listener.https.arn
  alb_security_group_id          = aws_security_group.alb.id
  vpc_endpoint_security_group_id = aws_security_group.vpc_endpoints.id

  # Database
  db_host                   = aws_db_instance.main.address
  db_port                   = aws_db_instance.main.port
  db_credentials_secret_arn = aws_secretsmanager_secret.db_credentials.arn

  # Dynamic Routing Priority
  alb_listener_rule_priority = 100

  # Per-tenant encryption & shared outbound email
  n8n_encryption_key_secret_arn = aws_secretsmanager_secret_version.key_acme.arn
  smtp_api_key_secret_arn       = aws_secretsmanager_secret.smtp_api_key.arn
}

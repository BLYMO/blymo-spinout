# ==============================================================================
# TryBase: Dify AI Agent Studio Workload Example
#
# This demonstrates running an isolated Dify AI Agent Studio instance for a tenant
# using TryBase's shared Graviton RDS cluster (with native pgvector for RAG)
# and private Fargate execution.
#
# How to run:
# 1. Copy this file:
#      cp tenant_dify.tf.example tenant_dify_acme.tf
# 2. Deploy this service:
#      terraform apply -target=module.dify_acme
# 3. Visit:
#      https://dify-acme.<your-base-domain> (e.g. https://dify-acme.yourdomain.com)
# ==============================================================================

module "dify_acme" {
  source = "./modules/generic-workload"

  service_name      = "dify-acme"
  subdomain         = "dify-acme"
  container_image   = "langgenius/dify-api:latest"
  container_port    = 5001
  health_check_path = "/healthz"
  cpu               = 1024 # 1.0 vCPU
  memory            = 2048 # 2048 MiB

  # Environment configuration for Dify with RDS pgvector
  environment_variables = {
    MODE                   = "api"
    LOG_LEVEL              = "INFO"
    SECRET_KEY             = "trybase-dify-secret-key-change-in-production"
    
    # Primary Database on TryBase Shared RDS
    DB_USERNAME            = "n8nmaster"
    DB_HOST                = aws_db_instance.main.address
    DB_PORT                = "5432"
    DB_DATABASE            = "db_dify_acme"
    
    # Vector Database: Use native RDS PostgreSQL pgvector (Zero external vector DB needed!)
    VECTOR_STORE           = "pgvector"
    PGVECTOR_HOST          = aws_db_instance.main.address
    PGVECTOR_PORT          = "5432"
    PGVECTOR_USER          = "n8nmaster"
    PGVECTOR_DATABASE      = "db_dify_acme"
  }

  # Bind to TryBase shared infrastructure
  vpc_id                     = module.vpc.vpc_id
  private_subnet_ids         = module.vpc.private_subnets
  ecs_cluster_name           = aws_ecs_cluster.main.name
  alb_listener_arn           = aws_lb_listener.https.arn
  alb_security_group_id      = aws_security_group.alb.id
  alb_listener_rule_priority = 250
  domain_name                = var.base_domain
}

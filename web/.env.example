# TryBase Frontend Environment Variables

# Supabase Control Plane (from 'supabase status' or your Supabase Cloud project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AWS API Gateway Provisioning Endpoint (from 'terraform output api_gateway_url')
VITE_API_GATEWAY_URL=https://your-api-id.execute-api.eu-west-2.amazonaws.com
